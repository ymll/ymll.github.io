<section id="contact" class="contact-area section-big">
  <div class="container">
    <div class="row">
      <div class="col-md-12 text-center">
        <div class="section-title">
          <h2><span>Contact</span> Me</h2>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-md-12">
        <p class="success" id="contact-thanks" style="display:none">Thanks &mdash; your message is on its way. I&rsquo;ll get back to you soon.</p>
        <!-- Free form backend: FormSubmit (formsubmit.co) — no account, no
             backend of our own; it emails each submission to Lily. The first
             submission needs one activation click in her inbox, then it
             just works. _captcha=false skips FormSubmit's captcha page;
             _honey is a hidden honeypot bots fill in and humans never see;
             _next sends the visitor back here with ?sent=1, which shows
             the thank-you note above. -->
        <form class="contact-form" action="https://formsubmit.co/yml.lily@gmail.com" method="POST">
          <input type="hidden" name="_subject" value="New message from ymll.github.io">
          <input type="hidden" name="_captcha" value="false">
          <input type="hidden" name="_next" value="https://ymll.github.io/?sent=1#contact">
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">
          <div class="form-group in_name">
            <input type="text" name="name" class="form-control" placeholder="Your name" required>
          </div>
          <div class="form-group in_email">
            <input type="email" name="email" class="form-control" placeholder="Your email" required>
          </div>
          <div class="form-group in_message">
            <textarea name="message" id="message" class="form-control" placeholder="Your message" required></textarea>
          </div>
          <div class="actions">
            <input type="submit" id="submitButton" class="btn" value="Send">
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
